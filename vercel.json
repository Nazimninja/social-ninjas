{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/standalone-crm", "destination": "/standalone-crm/index.html" },
    { "source": "/ai-products", "destination": "/index.html" },
    { "source": "/ai-products/(.*)", "destination": "/index.html" },
    { "source": "/tools", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/((?!api/|standalone-crm|assets/|favicon|logo|manifest|robots|sitemap|og-image|BingSite|ads|yandex_|8f7f1ad4b9714ebca808d4b3c95e1d90).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    }
  ]
}
